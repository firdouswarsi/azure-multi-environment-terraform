# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude sensitive secrets tfvars
*.secrets.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan
tfplan

# Security scan reports
checkov-report.xml
